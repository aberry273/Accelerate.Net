@using System.Collections.Generic
@using System.Linq
@using Accelerate.Features.Transactions.Models.Views
@using Accelerate.Foundations.Common.Helpers
@using Microsoft.AspNetCore.Http
@model TransactionsBasePage
@{
    Layout = "/Views/Shared/_TransactionsPageLayout.cshtml";
}
<div class="w-full h-full overflow-y-none">
    <!-- Channels panel -->
    <div x-data="aclTabsNavigation({
        items: [
